# ─── Supabase (required) ───
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App Config ───
DEMO_MODE=true
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── TikTok Scraping (required for ingestion) ───
# Get a free token at https://apify.com
# APIFY_API_TOKEN=apify_api_...

# ─── Transcription (required for video processing) ───
# OPENAI_API_KEY=sk-...

# ─── LLM Analysis (at least one required for insights) ───
# Falls back in order: Anthropic → OpenAI → mock heuristics
# ANTHROPIC_API_KEY=sk-ant-...
# KIMI_API_KEY=...

# ─── Upstash Redis (optional in dev, required in production) ───
# If omitted in development, an in-memory queue is used automatically.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ─── Security (optional, defaults to dev-secret-change-in-production) ───
# WORKER_SECRET=your-worker-secret
# CRON_SECRET=your-cron-secret
